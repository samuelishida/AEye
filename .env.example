# ============================================================
# AEye — chaves de API (100% gratuitas, sem cartão de crédito)
# Copie este arquivo para ".env" e preencha.
# ============================================================

# --- Obrigatória: Google AI Studio (principal) ---
# Crie grátis em: https://aistudio.google.com/apikey
# Gemini 2.5 Flash free tier: ~1.500 requisições/dia.
GEMINI_API_KEY=coloque_aqui_a_chave_gemini

# --- Obrigatória: Cerebras (fallback automático) ---
# Crie grátis em: https://cloud.cerebras.ai (console -> API Keys)
# Llama 3.3 70B grátis: 14.400 req/dia, 1M tokens/dia.
CEREBRAS_API_KEY=coloque_aqui_a_chave_cerebras

# --- Cadeia de provedores (ordem de tentativa) ---
AI_FALLBACK_CHAIN=gemini,cerebras

# --- Opcionais ---
# Modelo forte (toggle "⭐ Usar modelo forte" na UI).
# Usa o Claude Code INSTALADO no PC (conta/assinatura do usuário — sem API key).
# Se o Claude Code não estiver disponível, cai automaticamente na cadeia gratuita.
CLAUDE_CODE_MODEL=sonnet            # sonnet | opus | haiku | (vazio = padrão do usuário)
CLAUDE_CODE_TIMEOUT=180             # segundos
CLAUDE_CODE_MAX_TURNS=3
# API da Anthropic: só com chave PRÓPRIA (a Anthropic não suporta terceiros).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama local (OCR de manuscrito / VLM) — servidor 2 (porta 11435)
OLLAMA_URL=http://localhost:11435
OLLAMA_MODEL=aipib/LightOnOCR-2-1B:Q8_0   # ou deepseek-ocr (6,7GB, mais preciso)
OLLAMA_MODEL_TEXT=qwen3:4b    # texto offline (fallback extra, opcional)

# iGPU (Intel/AMD Vulkan): OLLAMA_FLASH_ATTENTION=0 é obrigatório — flash
# attention no backend Vulkan corrompe as embeddings de visão e o OCR sai
# como mojibake multilíngue. O run.sh já exporta FA=0 + K cache q8_0 (V f16,
# pois cache V quantizado exigiria flash attention). Veja .agents/learnings.
#OLLAMA_FLASH_ATTENTION=0
#OLLAMA_KV_CACHE_K_TYPE=q8_0

# --- Orquestrador local (fluxo de ação /api/act) ---
# MiniCPM (1B via Ollama) é o PRIMEIRO provedor do orquestrador; a cadeia global
# (AI_FALLBACK_CHAIN) de chat/OCR não muda. Escala p/ API gratuita se offline.
# O orquestrador roda num servidor Ollama PRÓPRIO (OLLAMA_URL_ORCH) — por padrão
# na porta 11434 (a porta padrão do Ollama) — para não disputar memória com o
# servidor de OCR/VLM (11435). Os scripts run.sh/run.ps1 sobem os dois.
AEYE_ORCH_MODEL=jewelzufo/MiniCPM5-1B:latest
AEYE_ORCH_CHAIN=minicpm,gemini,cerebras
OLLAMA_URL_ORCH=http://localhost:11434
# Cap de tokens do caminho JSON do orquestrador (thinking models 1B precisam disso).
AEYE_ORCH_MAX_TOKENS=2048

# Controle do computador via MCP (fase 2): 1 = habilitar
AEYE_MCP=1
# Comando que inicia o computer-control-mcp-server (wshobson/agents)
COMPUTER_CONTROL_MCP_CMD=npx -y @wshobson/mcp-server-computer-control

# Watcher de capturas de tela (PrtScn) — 1 = habilitado
AEYE_CLIPBOARD=1
# Intervalo (segundos) entre verificações do watcher de clipboard (default 0.5)
AEYE_CLIPBOARD_POLL=0.5

# Porta do servidor web local
AEYE_PORT=8080

# Nível de log (WARNING default; INFO para mais detalhe). O formato inclui request_id.
AEYE_LOG_LEVEL=WARNING

# --- Segurança (recomendado) ---
# PIN para acessar pelo celular. Sem isso, QUALQUER dispositivo na sua rede
# Wi-Fi pode usar o AEye (inclusive controlar o PC). Deixe vazio para desativar.
AEYE_PIN=

# --- Modo iGPU (opcional, Linux, Intel Vulkan) -------------------------------
# Descomente para fixar o Ollama do AEye na iGPU (não toca na dGPU nem na
# instância Ollama principal). Somente necessário se o OCR for para rodar na
# iGPU. Em dGPU AMD (Windows) nao use.
#AEYE_GPU=igpu
#AEYE_OLLAMA_BIN=/caminho/para/o/binario/ollama
#AEYE_OLLAMA_MODELS=/caminho/para/o/gravador/de/modelos
#AEYE_VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/intel_icd.json
